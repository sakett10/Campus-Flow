# Copy to .env locally. Never commit real secrets.

NODE_ENV=development

# Database: PostgreSQL is the authoritative, durable system of record for domain data, outbox, and audit
DATABASE_URL=postgres://campusflow:campusflow@localhost:5432/campusflow

# Redis / BullMQ: Ephemeral execution transport and worker scheduling infrastructure only (NOT system of record)
REDIS_URL=redis://localhost:6379

CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=campusflow-dev
STORAGE_ACCESS_KEY=replace_me
STORAGE_SECRET_KEY=replace_me
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# AI Provider: Ollama (default local, no key required) or Gemini (hosted, requires AI_PROVIDER_KEY)
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
# AI_PROVIDER_KEY is required only when AI_PROVIDER=gemini
AI_PROVIDER_KEY=

ENCRYPTION_KEY=replace_with_32_byte_base64_or_64_hex

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# Test-only. Must never be true in production.
AUTH_TEST_BYPASS=false
